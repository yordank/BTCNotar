{
  "name": "btcnotar",
  "version": "0.2.2",
  "description": "Free Bitcoin notarization: prove a text or file existed at a certain time. Send a SHA-256 hash, get a proof you can verify yourself on the Bitcoin blockchain (Merkle tree + OP_RETURN).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "btcnotar": "./bin/cli.js"
  },
  "files": [
    "index.js",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "bitcoin",
    "merkle-tree",
    "notarization",
    "timestamping",
    "op_return",
    "proof-of-existence",
    "blockchain",
    "timestamp",
    "sha256"
  ],
  "author": "Yordan Karparov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordank/BTCNotar.git",
    "directory": "packages/btcnotar"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bitcoinjs-lib": "^7.0.1",
    "dotenv": "^17.2.3",
    "ecpair": "^3.0.0",
    "tiny-secp256k1": "^2.2.4"
  },
  "homepage": "https://github.com/yordank/BTCNotar#readme"
}
