{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(dir:*)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Read(**/.env)",
      "Read(**/.breez-data/**)",
      "Read(**/.breez-sdk-data/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ]
  }
}
