{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(dir:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.breez-data/**)",
      "Read(**/.breez-sdk-data/**)",
      "Edit(agents/**)",
      "Write(agents/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ]
  }
}
